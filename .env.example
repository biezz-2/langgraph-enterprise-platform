# ============================================================================
# LangGraph Platform (LGP v2.0) - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
# .env is gitignored. Never commit actual credentials.
# ============================================================================

# Toggle Supabase usage. Set to true when all credentials below are configured.
# When false or credentials contain placeholder values, LGP automatically
# falls back to the local SQLite database (data/lgp.db). Safe by default.
USE_SUPABASE=false

# ---- Supabase Self-Hosted (Project-Isolated via schema 'langgraph') --------
# REST API endpoint of your self-hosted Supabase instance.
SUPABASE_URL=https://supabase-self-hosted.your-domain.com
# Isolated PostgreSQL schema. Must match schema declared in supabase-schema.sql.
SUPABASE_SCHEMA=langgraph
# Service Role JWT key (full access). Find in Supabase Studio -> Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY_HERE

# ---- Direct PostgreSQL Connection (asyncpg / Migration Scripts) ------------
# Host of your Supabase PostgreSQL backend.
SUPABASE_DB_HOST=supabase-self-hosted.your-domain.com
# Port (default 5432 for direct; 6543 for PgBouncer pooler).
SUPABASE_DB_PORT=5432
# Default Supabase DB name.
SUPABASE_DB_NAME=postgres
# PostgreSQL user (usually 'postgres' for Supabase self-hosted).
SUPABASE_DB_USER=postgres
# Database password. Set in Supabase Studio -> Settings -> Database.
SUPABASE_DB_PASSWORD=YOUR_POSTGRES_DB_PASSWORD_HERE

# ---- SQLite (Local fallback / standalone mode) ----------------------------
LGP_DB_PATH=./data/lgp.db
